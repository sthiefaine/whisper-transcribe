{
  "name": "laboitedechocolat-whisper",
  "version": "1.0.0",
  "description": "Service de transcription audio Scriberr (WhisperX) pour La Boîte de Chocolat",
  "scripts": {
    "up": "docker-compose up -d",
    "down": "docker-compose down",
    "restart": "docker-compose restart",
    "logs": "docker-compose logs -f scriberr",
    "logs-all": "docker-compose logs -f",
    "status": "docker-compose ps",
    "shell": "docker-compose exec scriberr /bin/bash",
    "test-health": "curl -f http://localhost:8080/health",
    "test-models": "curl http://localhost:8080/models",
    "clean": "docker-compose down -v && docker system prune -f",
    "clean:docker": "docker-compose down -v && docker system prune -af"
  },
  "keywords": [
    "scriberr",
    "whisperx",
    "transcription",
    "audio",
    "podcast",
    "docker",
    "api"
  ],
  "author": "La Boîte de Chocolat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sthiefaine/laboitedechocolat-whisper.git"
  },
  "config": {
    "port": 8080,
    "maxFileSize": "200MB",
    "timeout": "600s"
  }
}
