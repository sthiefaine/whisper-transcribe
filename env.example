# Scriberr Configuration

# HuggingFace Token pour la diarisation (optionnel mais recommandé)
# Obtenez votre token gratuit sur https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Port d'écoute (par défaut 8080)
PORT=8080

# Chemin de la base de données (relatif au volume)
DB_PATH=/app/data/scriberr.db

# Répertoire d'upload (relatif au volume)
UPLOAD_DIR=/app/data/uploads
