# Podcast Transcriber Configuration

# HuggingFace Token pour la diarisation (identification des speakers)
# Requis pour activer la diarisation
# Obtenez votre token sur https://huggingface.co/settings/tokens
# IMPORTANT: Acceptez les conditions sur https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# Configuration du modèle Whisper
# Options: tiny, base, small, medium, large-v1, large-v2, large-v3
MODEL_SIZE=large-v3

# Device: cpu ou cuda (si GPU disponible)
DEVICE=cpu

# Type de calcul: int8 pour CPU, float16 pour GPU
COMPUTE_TYPE=int8

# Nombre de threads CPU
CPU_THREADS=4

# Durée des chunks en secondes (5 minutes recommandé)
CHUNK_DURATION=300
