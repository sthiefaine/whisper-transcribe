# Podcast Transcriber Configuration

# Mistral AI API Key (REQUIRED)
# Obtenez votre clé API sur https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Modèle Voxtral à utiliser
# Options: voxtral-mini-latest (recommandé)
VOXTRAL_MODEL=voxtral-mini-latest

# Activer l'identification des speakers (diarisation)
# true ou false
ENABLE_DIARIZATION=true

# Timeout pour les appels API en secondes (1 heure par défaut)
# Augmentez pour les fichiers très longs
API_TIMEOUT=3600

# Taille maximale des fichiers en bytes (1GB par défaut)
MAX_FILE_SIZE=1073741824

# Nombre maximum de tentatives en cas d'échec
MAX_RETRY_COUNT=3
